{
  "name": "finderb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "clean": "node -e \"const fs=require('fs');const p='.next';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true,maxRetries:10,retryDelay:200});\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:leads": "node scripts/test-broadcast-lead.mjs --anon-only",
    "backfill:slugs": "node scripts/backfill-business-slugs.mjs",
    "backfill:slugs:dry": "node scripts/backfill-business-slugs.mjs --dry-run",
    "backfill:tourist-slugs": "node scripts/backfill-tourist-place-slugs.mjs",
    "backfill:tourist-slugs:dry": "node scripts/backfill-tourist-place-slugs.mjs --dry-run",
    "migrate:tourist-slugs": "node scripts/apply-tourist-place-slugs-sql.mjs",
    "regenerate:sitemap": "node scripts/regenerate-sitemap.mjs",
    "test:profiles": "node scripts/test-profile-urls.mjs",
    "backfill:payment-trails": "node scripts/backfill-merchant-payment-trails.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "country-state-city": "^3.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "next-cloudinary": "^6.17.5",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.9.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
