# =============================================================================
# Google Search Console — site ownership verification (HTML tag method)
# Search Console → Add property → URL prefix https://finderb.com → HTML tag
# Copy only the content value, e.g. if the tag is:
#   <meta name="google-site-verification" content="AbCdEf123" />
# set GOOGLE_SITE_VERIFICATION=AbCdEf123
# Add the same value in Vercel → Project → Settings → Environment Variables → Production
GOOGLE_SITE_VERIFICATION=

# Canonical site URL (no trailing slash). Use https://finderb.com after domain fix.
NEXT_PUBLIC_SITE_URL=https://finderb.com

# Meta (Facebook) App ID — renders <meta property="fb:app_id" /> for link previews.
# developers.facebook.com → Your Apps → create/select app → Settings → Basic → App ID
FACEBOOK_APP_ID=

# Server-only Supabase service role (profile view analytics, privileged writes).
# Supabase → Project Settings → API → service_role secret. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (database + user OAuth). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# User login/signup social providers shown on /login and /signup (comma-separated).
# Configure each provider in Supabase → Authentication → Providers first.
# See docs/USER_OAUTH_SETUP.md
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=google,apple,github

# Truecaller one-tap login (Android mobile web). See docs/TRUECALLER_SETUP.md
NEXT_PUBLIC_TRUECALLER_ENABLED=false
NEXT_PUBLIC_TRUECALLER_PARTNER_KEY=
NEXT_PUBLIC_TRUECALLER_PARTNER_NAME=FinderB

# Razorpay — merchant Growth Pro payments (dashboard Recharge Now)
# Dashboard: Account & Settings → API Keys (test or live mode)
#   Key Id     → NEXT_PUBLIC_RAZORPAY_KEY_ID  (rzp_test_… or rzp_live_…)
#   Key Secret → RAZORPAY_KEY_SECRET          (server only — never expose)
# Dashboard: Subscriptions → Plans → create monthly plan (₹499/month) → copy Plan Id:
#   RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_xxxxxxxx
# Dashboard: Account & Settings → Webhooks → create webhook, copy secret:
#   Webhook Secret → RAZORPAY_WEBHOOK_SECRET  (server only)
#   URL: https://finderb.com/api/razorpay/webhook
#   Events: payment.captured, payment.authorized,
#           subscription.authenticated, subscription.activated,
#           subscription.charged, subscription.cancelled, subscription.halted
# See docs/RAZORPAY_SETUP.md for step-by-step setup and test cards.

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO_MONTHLY=

# =============================================================================
# Google Maps Platform — location features
# =============================================================================
# Create keys at https://console.cloud.google.com/google/maps-apis/credentials
# Enable billing on the project (Google gives ~$200/month free Maps credit).
#
# Enable these APIs for FinderB:
#   • Geocoding API      — city/area labels from GPS coordinates (server-side)
#   • Geolocation API    — coarse fallback when browser GPS is unavailable (browser-side)
#   • Maps Embed API     — business profile map previews (browser iframe embeds)
#
# Recommended: use TWO keys (see docs/GOOGLE_LOCATION_SETUP.md).

# Server-only key for Geocoding (reverse geocode in app/actions/location.ts).
# Restrict in Google Cloud: Application restrictions → IP addresses (your server/Vercel).
GOOGLE_MAPS_API_KEY=

# Browser key for Geolocation API fallback (lib/geolocateClient.ts) and
# Maps Embed API iframes on business profiles (lib/businessContact.ts).
# Restrict in Google Cloud: Application restrictions → HTTP referrers
#   http://localhost:3000/*
#   https://yourdomain.com/*
#   https://*.yourdomain.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
