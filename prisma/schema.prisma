generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                                                     String       @id @default(cuid())
  fullName                                               String
  workEmail                                              String
  emailVerified                                          Boolean      @default(false)
  mobile                                                 String       @unique
  mobileVerified                                         Boolean      @default(false)
  businessName                                           String
  category                                               String
  location                                               String?
  publicPhone                                            String
  businessAddress                                        String
  selectedPlan                                           String
  billingCycle                                           String
  isVerified                                             Boolean      @default(false)
  registrationNumber                                     String?      @unique
  panNumber                                              String?
  aadharNumber                                           String?
  panUrl                                                 String?
  aadharUrl                                              String?
  msmeGstUrl                                             String?
  cinNumber                                              String?
  bankIfsc                                               String?
  bankAccountNumber                                       String?
  upiId                                                  String?
  razorpayContactId                                       String?
  razorpayFundAccountId                                   String?
  bankName                                               String?
  kycStatus                                              String       @default("pending")
  hasVerifiedBadge                                       Boolean      @default(false)
  paymentStatus                                          String       @default("pending")
  paymentId                                              String?
  orderId                                                String?
  planStartedAt                                          DateTime?
  planExpiresAt                                          DateTime?
  razorpaySubscriptionId                                 String?
  subscriptionStatus                                     String?
  autoRenewEnabled                                       Boolean      @default(false)
  mandateStatus                                          String?      @default("none")
  subscriptionCancelledAt                                DateTime?
  createdAt                                              DateTime     @default(now())
  updatedAt                                              DateTime     @updatedAt
  city                                                   String?
  email                                                  String?
  password                                               String?
  state                                                  String?
  country                                                String?
  status                                                 String       @default("Active")
  slug                                                   String?      @unique
  images                                                 String[]     @default([])
  profilePictureUrl                                      String?
  about                                                  String?
  discountRange                                          String?
  displayName                                            String?
  facebookUrl                                            String?
  instagramUrl                                           String?
  isFinderBVerified                                      Boolean      @default(false)
  keywords                                               String[]     @default([])
  latitude                                               Float?
  longitude                                              Float?
  paymentModes                                           String[]     @default([])
  profileQrLink                                          String?
  rating                                                 Float?
  serviceCategory                                        String?
  timings                                                Json?
  website                                                String?
  whatsappNumber                                         String?
  whatsappVerified                                       Boolean      @default(false)
  yearsInBusiness                                        Int?
  youtubeUrl                                             String?
  review                                                 Json?
  reviewReply                                            Json?
  jobs                                                   jobs[]
  tourist_place_merchants                                tourist_place_merchants[]
  categories_categories_position_1_business_idToBusiness categories[] @relation("categories_position_1_business_idToBusiness")
  categories_categories_position_2_business_idToBusiness categories[] @relation("categories_position_2_business_idToBusiness")
  categories_categories_position_3_business_idToBusiness categories[] @relation("categories_position_3_business_idToBusiness")
  categories_categories_position_4_business_idToBusiness categories[] @relation("categories_position_4_business_idToBusiness")
  categories_categories_position_5_business_idToBusiness categories[] @relation("categories_position_5_business_idToBusiness")
  leads                                                  leads[]
  merchant_payments                                      merchant_payments[]

  @@index([status], map: "idx_business_status")
  @@index([planExpiresAt], map: "idx_business_plan_expires_at")
  @@index([razorpaySubscriptionId], map: "idx_business_razorpay_subscription_id")
  @@index([subscriptionStatus], map: "idx_business_subscription_status")
  @@index([category], map: "idx_business_category")
  @@index([city], map: "idx_business_city")
  @@index([slug], map: "idx_business_slug")
}

model jobs {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  type        String
  location    String
  salary      String?
  description String
  department  String?
  status      String   @default("active")
  business_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id], map: "idx_jobs_business_id")
}

model categories {
  id                                                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                 String
  type                                                 String       @default("Merchant")
  items_count                                          Int          @default(0)
  status                                               String       @default("Active")
  banner                                               String?      @default("Not Set")
  fixed_slots                                          Int          @default(0)
  position_1_business_id                               String?
  position_2_business_id                               String?
  position_3_business_id                               String?
  position_4_business_id                               String?
  position_5_business_id                               String?
  created_at                                           DateTime     @default(now()) @db.Timestamp(6)
  updated_at                                           DateTime     @default(now()) @db.Timestamp(6)
  symbol                                               String?      @default("Not Set")
  parent_id                                            String?      @db.Uuid
  slug                                                 String?
  keywords                                             String[]
  level                                                Int?         @default(1)
  position                                             Int?         @default(0)
  categories                                           categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories                                     categories[] @relation("categoriesTocategories")
  Business_categories_position_1_business_idToBusiness Business?    @relation("categories_position_1_business_idToBusiness", fields: [position_1_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_2_business_idToBusiness Business?    @relation("categories_position_2_business_idToBusiness", fields: [position_2_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_3_business_idToBusiness Business?    @relation("categories_position_3_business_idToBusiness", fields: [position_3_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_4_business_idToBusiness Business?    @relation("categories_position_4_business_idToBusiness", fields: [position_4_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_5_business_idToBusiness Business?    @relation("categories_position_5_business_idToBusiness", fields: [position_5_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, parent_id], map: "unique_name_per_parent")
  @@index([status])
  @@index([type])
  @@index([parent_id])
  @@index([symbol])
}

model User {
  id               String   @id @default(cuid())
  fullName         String
  email            String   @unique
  password         String
  authProvider     String?
  avatarUrl        String?
  supabaseAuthId   String?  @unique
  phone            String?  @unique
  truecallerUserId String?  @unique
  emailVerified    Boolean  @default(false)
  phoneVerified    Boolean  @default(false)
  favorites        String[] @default([])
  searchHistory    String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model movies {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  finderb_rating Decimal?  @db.Decimal(3, 1)
  release_date   DateTime? @db.Date
  poster_url     String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model news {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  content      String
  author       String?
  image_url    String?
  published_at DateTime? @default(now()) @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tourist_places {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  location       String
  category       String?
  image_url      String?
  slug           String?                  @unique
  best_time      String?
  visit_duration String?
  entry_fee      String?
  how_to_reach   String?
  highlights     String?
  tips           String?
  created_at     DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?                @default(now()) @db.Timestamptz(6)
  merchants      tourist_place_merchants[]

  @@index([slug], map: "idx_tourist_places_slug")
}

/// Merchants tagged on a tourist place (e.g. Tour & Travels partners).
model tourist_place_merchants {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourist_place_id String         @db.Uuid
  business_id      String
  sort_order       Int            @default(0)
  note             String?
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  place            tourist_places @relation(fields: [tourist_place_id], references: [id], onDelete: Cascade)
  Business         Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([tourist_place_id, business_id], map: "tourist_place_merchants_tourist_place_id_business_id_key")
  @@index([tourist_place_id, sort_order], map: "idx_tourist_place_merchants_place")
  @@index([business_id], map: "idx_tourist_place_merchants_business")
}

model admins {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  password     String
  role         String    @default("admin")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  is_disabled  Boolean?  @default(false)
  allowed_tabs String[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model broadcasts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String?
  message         String
  target_audience String[]
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}

model leads {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String?
  phone            String?
  category         String
  business_id      String?
  message          String?
  status           String    @default("New")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  merchant_read_at DateTime? @db.Timestamptz(6)
  Business         Business? @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category])
  @@index([status])
  @@index([business_id], map: "idx_leads_business_id")
  @@index([created_at], map: "idx_leads_created_at")
}

model merchant_payments {
  id              String    @id @default(cuid())
  business_id     String
  plan            String
  billing_cycle   String
  amount_paise    Int
  currency        String    @default("INR")
  status          String    @default("pending")
  order_id        String?
  payment_id              String?   @unique
  razorpay_subscription_id String?
  payment_type            String    @default("one_time")
  source                  String?
  plan_started_at DateTime?
  plan_expires_at DateTime?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
  Business        Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id], map: "idx_merchant_payments_business_id")
  @@index([status], map: "idx_merchant_payments_status")
  @@index([created_at], map: "idx_merchant_payments_created_at")
  @@index([order_id], map: "idx_merchant_payments_order_id")
  @@index([razorpay_subscription_id], map: "idx_merchant_payments_subscription_id")
}

model blogs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  slug         String    @unique
  content      String
  excerpt      String?
  author       String?   @default("FinderB Admin")
  category     String?
  tags         String[]
  image_url    String?
  status       String?   @default("draft")
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

/// Homepage Tutorials playlists curated from the admin panel.
model youtube_playlists {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  sort_order   Int              @default(0)
  is_published Boolean          @default(true)
  created_at   DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?        @default(now()) @db.Timestamptz(6)
  videos       youtube_videos[]

  @@index([is_published, sort_order], map: "idx_youtube_playlists_published_sort")
}

model youtube_videos {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playlist_id      String            @db.Uuid
  youtube_video_id String
  title            String
  description      String?
  topic            String?
  thumbnail_url    String
  watch_url        String
  sort_order       Int               @default(0)
  is_published     Boolean           @default(true)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  playlist         youtube_playlists @relation(fields: [playlist_id], references: [id], onDelete: Cascade)

  @@unique([playlist_id, youtube_video_id], map: "idx_youtube_videos_playlist_video_unique")
  @@index([playlist_id, is_published, sort_order], map: "idx_youtube_videos_playlist_sort")
}
