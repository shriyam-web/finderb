generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                                                     String       @id @default(cuid())
  fullName                                               String
  workEmail                                              String
  mobile                                                 String       @unique
  businessName                                           String
  category                                               String
  location                                               String?
  publicPhone                                            String
  businessAddress                                        String
  selectedPlan                                           String
  billingCycle                                           String
  isVerified                                             Boolean      @default(false)
  registrationNumber                                     String?      @unique
  panNumber                                              String?
  aadharNumber                                           String?
  panUrl                                                 String?
  aadharUrl                                              String?
  msmeGstUrl                                             String?
  kycStatus                                              String       @default("pending")
  hasVerifiedBadge                                       Boolean      @default(false)
  paymentStatus                                          String       @default("pending")
  paymentId                                              String?
  orderId                                                String?
  createdAt                                              DateTime     @default(now())
  updatedAt                                              DateTime     @updatedAt
  city                                                   String?
  email                                                  String?
  password                                               String?
  state                                                  String?
  country                                                String?
  status                                                 String       @default("Active")
  images                                                 String[]     @default([])
  profilePictureUrl                                      String?
  about                                                  String?
  discountRange                                          String?
  displayName                                            String?
  facebookUrl                                            String?
  instagramUrl                                           String?
  isFinderBVerified                                      Boolean      @default(false)
  keywords                                               String[]     @default([])
  latitude                                               Float?
  longitude                                              Float?
  paymentModes                                           String[]     @default([])
  profileQrLink                                          String?
  rating                                                 Float?
  serviceCategory                                        String?
  timings                                                Json?
  website                                                String?
  whatsappNumber                                         String?
  yearsInBusiness                                        Int?
  youtubeUrl                                             String?
  review                                                 Json?
  reviewReply                                            Json?
  jobs                                                   jobs[]
  categories_categories_position_1_business_idToBusiness categories[] @relation("categories_position_1_business_idToBusiness")
  categories_categories_position_2_business_idToBusiness categories[] @relation("categories_position_2_business_idToBusiness")
  categories_categories_position_3_business_idToBusiness categories[] @relation("categories_position_3_business_idToBusiness")
  leads                                                  leads[]
}

model jobs {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  type        String
  location    String
  salary      String?
  description String
  department  String?
  status      String   @default("active")
  business_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id], map: "idx_jobs_business_id")
}

model categories {
  id                                                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                 String
  type                                                 String       @default("Merchant")
  items_count                                          Int          @default(0)
  status                                               String       @default("Active")
  banner                                               String?      @default("Not Set")
  fixed_slots                                          Int          @default(0)
  position_1_business_id                               String?
  position_2_business_id                               String?
  position_3_business_id                               String?
  created_at                                           DateTime     @default(now()) @db.Timestamp(6)
  updated_at                                           DateTime     @default(now()) @db.Timestamp(6)
  symbol                                               String?      @default("Not Set")
  parent_id                                            String?      @db.Uuid
  slug                                                 String?
  keywords                                             String[]
  level                                                Int?         @default(1)
  position                                             Int?         @default(0)
  categories                                           categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories                                     categories[] @relation("categoriesTocategories")
  Business_categories_position_1_business_idToBusiness Business?    @relation("categories_position_1_business_idToBusiness", fields: [position_1_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_2_business_idToBusiness Business?    @relation("categories_position_2_business_idToBusiness", fields: [position_2_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Business_categories_position_3_business_idToBusiness Business?    @relation("categories_position_3_business_idToBusiness", fields: [position_3_business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, parent_id], map: "unique_name_per_parent")
  @@index([status])
  @@index([type])
  @@index([parent_id])
  @@index([symbol])
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  password      String
  favorites     String[] @default([])
  searchHistory String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model movies {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  finderb_rating Decimal?  @db.Decimal(3, 1)
  release_date   DateTime? @db.Date
  poster_url     String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model news {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  content      String
  author       String?
  image_url    String?
  published_at DateTime? @default(now()) @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tourist_places {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  location    String
  category    String?
  image_url   String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model admins {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  password     String
  role         String    @default("admin")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  is_disabled  Boolean?  @default(false)
  allowed_tabs String[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model broadcasts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String?
  message         String
  target_audience String[]
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}

model leads {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String?
  phone       String?
  category    String
  business_id String?
  message     String?
  status      String    @default("New")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  Business    Business? @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category])
  @@index([status])
}
