{
  "expo": {
    "name": "FinderB",
    "slug": "finderb",
    "description": "Find trusted local businesses, services, doctors and jobs near you across India.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finderb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finderb.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:finderb.com",
        "applinks:www.finderb.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FinderB uses your location to show trusted businesses near you.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.finderb.app",
      "versionCode": 18,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "finderb.com",
              "pathPrefix": "/business"
            },
            {
              "scheme": "https",
              "host": "www.finderb.com",
              "pathPrefix": "/business"
            },
            {
              "scheme": "https",
              "host": "finderb.com",
              "pathPrefix": "/blog"
            },
            {
              "scheme": "https",
              "host": "www.finderb.com",
              "pathPrefix": "/blog"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "finderb",
              "host": "*",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/splash-full.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          },
          "android": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 220,
            "backgroundColor": "#FFFFFF",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0C0A09",
          "style": "light",
          "enforceContrast": false
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FinderB to use your location to show nearby trusted businesses."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E8811E",
          "defaultChannel": "finderb_heads_up",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow FinderB to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow FinderB to turn your speech into search text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FinderB to use a photo from your gallery as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withTruecallerQueries.js",
      "./plugins/withReleaseSigning.js",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://finderb.com"
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "30fedeed-3ebc-4dfd-af33-d342cb3645a3"
      }
    }
  }
}
